project_name      = "lab"
route53_zone_name = "example.com"
vpc_name          = "hashistack"
nomad_license     = "your-nomad-enterprise-license-here"

ec2_key_pair_name = "my-key-pair"
ec2_ami_owner     = "123456789012"
ec2_ami_name      = "ubuntu/images/hvm-ssd-gp3/ubuntu-noble-24.04-amd64-server-*"

consul_auto_join_ec2_tag = {
  key   = "consul-cluster"
  value = "lab"
}

consul_ca_cert_secret_arn    = "arn:aws:secretsmanager:us-east-1:123456789012:secret:example-ca-cert"
consul_gossip_key_secret_arn = "arn:aws:secretsmanager:us-east-1:123456789012:secret:example-gossip-key"
consul_token_secret_arn      = "arn:aws:secretsmanager:us-east-1:123456789012:secret:example-token"

nomad_server_service_name   = "nomad-server"
nomad_client_service_name   = "nomad-client"
nomad_snapshot_service_name = "nomad-snapshot"

nlb_internal            = false
nomad_api_allowed_cidrs = ["0.0.0.0/0"]
